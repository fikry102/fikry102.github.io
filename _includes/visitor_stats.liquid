<section class="visitor-stats" aria-labelledby="visitor-stats-title">
  <div class="visitor-stats__heading">
    <div>
      <h2 id="visitor-stats-title">Visitors</h2>
      <p>Page views and geographic distribution since September 2026</p>
    </div>
  </div>

  <div class="visitor-stats__content">
    <div class="visitor-stats__panel visitor-stats__countries">
      <h3>Visits by country</h3>
      <a href="https://s01.flagcounter.com/more/fkl26v9/" target="_blank" rel="noopener noreferrer">
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset="https://s01.flagcounter.com/count2/fkl26v9/bg_1C1C1D/txt_E8E8E8/border_3D3D3D/columns_2/maxflags_12/viewers_0/labels_1/pageviews_1/flags_0/percent_0/"
          >
          <img
            src="https://s01.flagcounter.com/count2/fkl26v9/bg_FFFFFF/txt_333333/border_DDDDDD/columns_2/maxflags_12/viewers_0/labels_1/pageviews_1/flags_0/percent_0/"
            alt="Visitor and page-view totals grouped by country"
            loading="lazy"
          >
        </picture>
      </a>
    </div>

    <div class="visitor-stats__panel visitor-stats__trend">
      <h3>Visitor trend · last 30 days</h3>
      <a href="https://s01.flagcounter.com/more30/fkl26v9/" target="_blank" rel="noopener noreferrer">
        <img
          src="https://s01.flagcounter.com/chart2.cgi?fkl26v9&amp;chart=30"
          alt="Visitor and page-view trend over the last 30 days"
          loading="lazy"
        >
      </a>
    </div>

    <div class="visitor-stats__panel">
      <h3>Live visitor map</h3>
      <div id="visitor-map" class="visitor-stats__map" aria-label="Map showing visitor locations">
        <script id="_wauf10">
          var _wau_opt = { target: '_blank', fd: true };
          var visitorMap = document.getElementById('visitor-map');
          var visitorMapWidth = Math.min(420, Math.max(220, Math.floor(visitorMap.clientWidth || window.innerWidth - 64)));
          var visitorMapHeight = Math.round(visitorMapWidth / 2);
          var _wau = _wau || [];
          _wau.push(['map', 'k3r8m1p7q2', 'f10', String(visitorMapWidth), String(visitorMapHeight), 'heatmode', 'default-pink']);
        </script>
        <script async src="https://waust.at/m.js"></script>
      </div>
    </div>
  </div>
</section>
