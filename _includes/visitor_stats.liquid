<section class="visitor-stats" aria-labelledby="visitor-stats-title">
  <div class="visitor-stats__heading">
    <div>
      <h2 id="visitor-stats-title">Visitors</h2>
      <p>Page views and geographic distribution since September 2026</p>
    </div>
  </div>

  <div class="visitor-stats__content">
    <div class="visitor-stats__panel visitor-stats__countries">
      <h3>Visits by country</h3>
      <a href="https://s01.flagcounter.com/more/fkl26v9/" target="_blank" rel="noopener noreferrer">
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset="https://s01.flagcounter.com/count2/fkl26v9/bg_1C1C1D/txt_E8E8E8/border_3D3D3D/columns_2/maxflags_12/viewers_0/labels_1/pageviews_1/flags_0/percent_0/"
          >
          <img
            src="https://s01.flagcounter.com/count2/fkl26v9/bg_FFFFFF/txt_333333/border_DDDDDD/columns_2/maxflags_12/viewers_0/labels_1/pageviews_1/flags_0/percent_0/"
            alt="Visitor and page-view totals grouped by country"
            loading="lazy"
          >
        </picture>
      </a>
    </div>

    <div class="visitor-stats__panel">
      <h3>Live visitor map</h3>
      <div id="visitor-map" class="visitor-stats__map" aria-label="Map showing visitor locations">
        <span class="visitor-stats__map-placeholder" aria-hidden="true">
          <i class="fa-solid fa-location-dot"></i>
          Loading the live map when it comes into view
        </span>
      </div>
      <script>
        (() => {
          const visitorMap = document.getElementById('visitor-map');
          if (!visitorMap) return;

          const loadVisitorMap = () => {
            if (visitorMap.dataset.loaded === 'true') return;
            visitorMap.dataset.loaded = 'true';
            visitorMap.querySelector('.visitor-stats__map-placeholder')?.remove();

            const mapWidth = Math.min(420, Math.max(220, Math.floor(visitorMap.clientWidth || window.innerWidth - 64)));
            const mapHeight = Math.round(mapWidth / 2);
            window._wau_opt = { target: '_blank', fd: true };
            window._wau = window._wau || [];
            window._wau.push(['map', 'k3r8m1p7q2', 'f10', String(mapWidth), String(mapHeight), 'heatmode', 'default-pink']);

            const mapScript = document.createElement('script');
            mapScript.async = true;
            mapScript.src = 'https://waust.at/m.js';
            visitorMap.appendChild(mapScript);
          };

          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
              (entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                  observer.disconnect();
                  loadVisitorMap();
                }
              },
              { rootMargin: '320px 0px' }
            );
            observer.observe(visitorMap);
          } else {
            loadVisitorMap();
          }
        })();
      </script>
      <noscript><p class="visitor-stats__fallback">Enable JavaScript to view the live visitor map.</p></noscript>
    </div>
  </div>
</section>
